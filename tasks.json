{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build (MSVC + Qt6)",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Module Tests",
            "type": "shell",
            "command": "${workspaceFolder}/build-tests.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}